EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_public_token
MAPBOX_DOWNLOADS_TOKEN=sk.your_secret_downloads_token

# Optional Mapbox Studio styles. Built-in Mapbox styles are used when omitted.
EXPO_PUBLIC_MAPBOX_STYLE_MODERN=mapbox://styles/your-account/your-modern-style
EXPO_PUBLIC_MAPBOX_STYLE_TRADITIONAL=mapbox://styles/your-account/your-traditional-style
EXPO_PUBLIC_MAPBOX_STYLE_DARK=mapbox://styles/your-account/your-dark-style

# AISStream credentials stay in the relay process and are never bundled.
AISSTREAM_API_KEY=your_server_side_api_key
# Use 0.0.0.0 when browsers on other devices connect to this machine.
AIS_RELAY_HOST=127.0.0.1
AIS_RELAY_PORT=8790
# Exact browser origins, comma-separated. Example: http://192.168.1.10:8081
AIS_RELAY_ALLOWED_ORIGINS=http://localhost:8081
# On web, a loopback hostname is replaced with the page hostname automatically.
EXPO_PUBLIC_AIS_RELAY_URL=ws://localhost:8790
